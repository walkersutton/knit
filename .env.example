# Secrets live in dotenvx-encrypted .env.production (committed). Set them with:
#   pnpm exec dotenvx set RAVELRY_CLIENT_ID <id> -f .env.production
#   pnpm exec dotenvx set RAVELRY_CLIENT_SECRET <secret> -f .env.production
# The private key is in .env.keys (gitignored) and in Vercel as DOTENV_PRIVATE_KEY_PRODUCTION.
#
# DATABASE_URL is injected by the Vercel Neon integration; for local dev, `vercel env pull .env.local`.
PUBLIC_ORIGIN=https://knit.walkersutton.com
DATABASE_URL=

# /admin signs the owner in through walkersutton.com's shared ws_admin session, like stats.walkersutton.com.
# Optional: point it at another deployment of that site (defaults to https://walkersutton.com).
# AUTH_ORIGIN=

# Feedback is gated by Cloudflare Turnstile (action "feedback"). The sitekey is public and lives in
# src/lib/feedback/turnstile.ts; the secret goes in .env.production via dotenvx:
#   pnpm exec dotenvx set TURNSTILE_SECRET <secret> -f .env.production
# Optional: hostnames siteverify must report, comma-separated (defaults to PUBLIC_ORIGIN's host).
# Never include localhost here. In `pnpm dev` without a secret, Cloudflare's test keys are used.
# TURNSTILE_HOSTNAMES=knit.walkersutton.com
