    "seed": "dotenvx run -q -f .env.local -- vite-node --config scripts/vite.config.ts scripts/seed.ts --"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.5",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "three": "^0.187.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-node": "3.2.4",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@neondatabase/serverless": "^1.2.1",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.63.2"
  }
